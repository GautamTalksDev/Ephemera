{
  "name": "ephemera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @ephemera/api dev\" \"pnpm --filter @ephemera/worker dev\" \"pnpm --filter @ephemera/web dev\"",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter=@ephemera/core --filter=@ephemera/api --filter=@ephemera/worker test",
    "drive:mock-provider": "tsx scripts/drive-mock-provider.ts",
    "db:generate": "pnpm --filter @ephemera/api db:generate",
    "db:migrate": "pnpm --filter @ephemera/api db:migrate",
    "db:seed": "pnpm --filter @ephemera/api db:seed",
    "db:claim-concurrent": "tsx scripts/claim-concurrent.ts",
    "replay:github-webhook": "tsx scripts/replay-github-webhook.ts",
    "gate:reconciler": "tsx scripts/gate-reconciler.ts",
    "gate:compose-import": "tsx scripts/gate-compose-import.ts",
    "smoke": "tsx --env-file=.env scripts/smoke-zerops.ts",
    "deploy:zerops": "bash scripts/deploy-zerops.sh"
  },

  "dependencies": {
    "@ephemera/core": "workspace:*",
    "bullmq": "^5.58.5",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3"
  },

  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
