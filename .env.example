DATABASE_URL=postgres://ephemera:ephemera@localhost:5432/ephemera
REDIS_URL=redis://localhost:6379
PORT=3000
# Optional: exposed on GET /health as gitSha (web corner badge falls back to this).
GIT_SHA=
# Required for mutating API routes (POST/PATCH/DELETE). Unset = fail closed (401).
EPHEMERA_ADMIN_TOKEN=dev-admin-token
# Optional comma-separated GitHub owners; when set, refuse all other repos.
# EPHEMERA_ALLOWED_REPO_OWNERS=GautamTalksDev,acme
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_TOKEN=dev-github-token

PROVIDER=mock
MOCK_FAILURE_RATE=0
MOCK_PROVISION_MS=20000
PREVIEW_TTL_MINUTES=60
MAX_CONCURRENT_ENVS=3
RECONCILE_SCAN_MS=10000
REAPER_EVERY_MS=60000
EPHEMERA_USE_EXAMPLE_PREVIEW=1
EPHEMERA_POST_COMMENTS=0

# Checkpoint 7+ — real Zerops credits. Keep PROVIDER=mock for day-to-day.
# ZEROPS_PROJECT_ID = preview-envs project (LIGHT), NOT the control-plane project.
ZEROPS_PROJECT_ID=
ZEROPS_API_TOKEN=
ZEROPS_ORG_ID=
# Control-plane project id after `zcli project project-import zerops-project-import.yml`
EPHEMERA_APP_PROJECT_ID=
# On Zerops itself, custom ZEROPS_* keys are forbidden — worker uses these instead:
# EPHEMERA_PREVIEW_TOKEN / EPHEMERA_PREVIEW_PROJECT_ID
